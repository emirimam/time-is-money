# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only — used to send invitations. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# Optional: public URL of the app (used in invitation links)
NEXT_PUBLIC_SITE_URL=https://time-is-money.vercel.app
